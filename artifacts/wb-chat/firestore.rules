rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only whitelist two specific user UIDs.
    // Replace these with the actual anonymous UIDs of the two users after they login once.
    // USER_1_UID = "..."
    // USER_2_UID = "..."
    
    function isWhitelisted() {
      // return request.auth != null && (request.auth.uid == "USER_1_UID" || request.auth.uid == "USER_2_UID");
      return request.auth != null; // For initial setup, allow any authenticated user. Restrict later.
    }

    match /rooms/private-room/{document=**} {
      allow read, write: if isWhitelisted();
    }
  }
}
